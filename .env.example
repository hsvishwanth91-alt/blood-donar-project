# ─────────────────────────────────────────────
#  BloodLink — Environment Variables
#  Copy this file to .env and fill in your keys
# ─────────────────────────────────────────────

# SERVER
PORT=3000

# ── TWILIO CREDENTIALS ──────────────────────
# Get these from: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Your Twilio phone number (must be SMS + Voice enabled)
# Format: +1XXXXXXXXXX  or  +91XXXXXXXXXX
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# ── OPTIONAL: TWILIO VERIFY (OTP) ───────────
# Create a Verify Service at: https://console.twilio.com/us1/develop/verify/services
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ─────────────────────────────────────────────
#  HOW TO GET TWILIO KEYS (Free Trial):
#  1. Sign up at https://www.twilio.com/try-twilio
#  2. Go to Console → Account Info
#  3. Copy Account SID and Auth Token
#  4. Get a free phone number from Phone Numbers → Manage → Buy a Number
#  5. Enable SMS + Voice capabilities on that number
# ─────────────────────────────────────────────
